              "target": "책",
              "roman": "chaek",
              "en": "book"
            },
            {
              "id": "ko-saram",
              "target": "사람",
              "roman": "sa-ram",
              "en": "person"
            },
            {
              "id": "ko-hanguk",
              "target": "한국",
              "roman": "han-guk",
              "en": "Korea"
            },
